#include <stdio.h>

int main() {
    int a, b, sum;
    int *p1, *p2;

    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);

    p1 = &a; // p1 holds the address of a
    p2 = &b; // p2 holds the address of b

    sum = *p1 + *p2; // *p1 and *p2 give the values stored at those addresses

    printf("Sum = %d\n", sum);

    return 0;
}
